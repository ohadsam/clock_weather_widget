    <string name="sec_privacy">Privacy and about</string>
    <string name="sec_privacy_sum">Version %1$s</string>
    <string name="privacy_body">Your data stays on the device. Network requests: weather and city search (Open-Meteo, rounded coordinates only), and, only when you press "Check for updates", GitHub. Location, calendar and steps are read only if you allow it and are never sent anywhere. The Hebrew calendar and holidays are computed on the device.</string>
